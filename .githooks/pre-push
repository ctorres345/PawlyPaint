#!/bin/sh
# generated by nousfx_sync from NousFX claude/githooks/pre-push. Do not edit; change the source and re-run.
# Advisory pre-push gate for tools without Claude hooks (Antigravity, OpenCode, plain git).
# Asks the review gate whether this code has a recorded review, and fails CLOSED: a missing repo,
# gate script, python3 or git error blocks the push.
#
# What it judges: git sends one line per ref on stdin ("local_ref local_sha remote_ref remote_sha").
# Deletes, tag pushes and pushes of the default branch are allowed without a review, and so is a
# <prefix>/<KEY>-shots branch that holds only media under shots/<KEY>/ (gate: check-shots). Any other
# branch push is judged on the tree of the pushed commit (local_sha), not the checked-out branch:
# that tree needs a valid review mark, and the pushed branch name must follow the naming rule.
#
# The gate script runs from OUTSIDE every work tree: <home>/.claude/hooks/review-gate.py, with
# pr_create_parser.py beside it. A copy inside a repo would be code under review, and a branch
# could edit it to pass. <home> comes from the passwd record, not $HOME. REVIEW_GATE_DIR (set in
# your own shell, used by the tests) overrides the folder, and is refused inside any git work tree.
#
# It is advisory: `git push --no-verify` skips it. CI is the real gate (see docs/review-gate.md).
#
# Install: run the sync (python3 -B scripts/nousfx_sync.py --tools claude), which puts the gate files from
# this repo's claude/hooks/ in <home>/.claude/hooks/ (or copy them there by hand), then
#   cp claude/githooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
# or: git config core.hooksPath <dir holding this file>
fail() { echo "pre-push: blocked: $1" >&2; exit 2; }

root=$(git rev-parse --show-toplevel 2>/dev/null) || fail "not inside a git work tree"
command -v python3 >/dev/null 2>&1 || fail "python3 not found"

dir=${REVIEW_GATE_DIR:-}
if [ -z "$dir" ]; then
  home=$(python3 -I -c 'import os, pwd; print(pwd.getpwuid(os.getuid()).pw_dir)' 2>/dev/null) || fail "cannot find the home folder"
  dir="$home/.claude/hooks"
fi

# The gate must live outside every work tree. Fail closed on any answer but a clean "not in one".
if [ -d "$dir" ]; then
  inside=$(cd "$dir" && env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR -u GIT_INDEX_FILE LC_ALL=C \
    git rev-parse --is-inside-work-tree 2>&1)
  case "$inside" in
    true) fail "the gate folder $dir is inside a git work tree; use a folder outside every repo" ;;
    false|*"not a git repository"*) ;;
    *) fail "cannot tell whether the gate folder $dir is inside a git work tree" ;;
  esac
fi
script="$dir/review-gate.py"
[ -f "$script" ] || fail "review gate not found at $script (copy claude/hooks/review-gate.py and pr_create_parser.py there, or push with --no-verify)"

default=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)
default=${default#origin/}

zero=0000000000000000000000000000000000000000
while read -r lref lsha rref rsha; do
  [ -n "$lref" ] || continue
  case "$rref" in refs/tags/*) continue ;; esac
  case "$lref" in refs/tags/*) continue ;; esac
  case "$lsha" in "" | "$zero" | "$zero$zero") continue ;; esac
  branch=${rref#refs/heads/}
  case "$branch" in main|master) continue ;; esac
  [ -n "$default" ] && [ "$branch" = "$default" ] && continue
  case "$branch" in
    *-shots)
      # A screenshots branch never merges: it may skip the review when it holds only media under shots/<KEY>/ (NFX-143).
      # Pass only on the gate's own success line, so a gate that does not know check-shots cannot let a push through.
      base=""
      if [ -n "$default" ]; then base="refs/remotes/origin/$default"
      else # a repo set up with `git remote add` has no origin/HEAD
        for guess in refs/remotes/origin/main refs/remotes/origin/master; do
          git rev-parse --verify --quiet "$guess^{commit}" >/dev/null 2>&1 && { base=$guess; break; }
        done
      fi
      # Full ref names: a local branch called origin/main must not shadow the remote one.
      # Exit 0 AND the success line on stdout. The reason for a rejection goes to stderr and names the offending paths,
      # which anyone can name "no review needed.", so stderr is never part of the test.
      errf=$(mktemp) || fail "cannot create a temp file"
      if out=$(python3 -I -B "$script" check-shots "$branch" --head "$lsha" ${base:+--base "$base"} --cwd "$root" </dev/null 2>"$errf"); then
        case "$out" in *"no review needed.") rm -f "$errf"; continue ;; esac
      fi
      [ -s "$errf" ] && { printf 'pre-push: ' >&2; cat "$errf" >&2; }
      rm -f "$errf" ;;
  esac
  tree=$(git rev-parse --verify --quiet "$lsha^{tree}" 2>/dev/null) || fail "cannot read the commit $lsha pushed to $branch"
  python3 -I -B "$script" check --cwd "$root" --command "gh pr create" --tree "$tree" --branch "$branch" </dev/null || exit 2
done
exit 0
