{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|mcp__.*create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/review-gate.py\"; [ -f \"$HOME/.claude/hooks/review-gate.py\" ] || [ ! -f \"$f\" ] || python3 \"$f\" --budget 55",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
